# 复制为 .env 后填写；.env 已被 gitignore。AI 供应商不在这里，在页面的「设置」里配置。

# 对外访问地址（Pocket ID 回调 = 这个地址 + /auth/callback）
VM_BASE_URL=https://video.example.com

# Pocket ID（OIDC）—— 唯一的登录方式；第一个登录的账号成为所有者
VM_OIDC_ISSUER=https://id.example.com
VM_OIDC_CLIENT_ID=
VM_OIDC_CLIENT_SECRET=

# 会话签名 + AI Key 加密的主密钥：python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
# 更换后需要重新登录，并重新填写 AI Key
VM_SECRET_KEY=

# 可选
# VM_LEASE_MINUTES=60
# VM_MAX_VIDEO_MB=2048
